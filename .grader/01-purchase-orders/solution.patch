+def same_person(first, second):
+    return first.strip().casefold() == second.strip().casefold()
+
+
+@transaction.atomic
+def approve_order(order, approver):
+    ensure_status(order, PurchaseOrder.Status.SUBMITTED, "Only submitted orders can be approved.")
+    if same_person(approver, order.requested_by):
+        raise ValidationError({"approver": ["Orders can't be approved by the person who requested them."]})
+    order.status = PurchaseOrder.Status.APPROVED
+    order.approved_by = approver.strip()
+    order.approved_at = timezone.now()
+    order.save(update_fields=["status", "approved_by", "approved_at", "updated_at"])
+    return order
